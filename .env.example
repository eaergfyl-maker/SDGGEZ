# Copy to .env for local use. On Replit, use the Secrets tool instead.
# Never commit real values.

DB_PATH=data/app.db

# Optional: AI suggestions in the CV reader (RunPod serverless vLLM endpoint).
# Leave empty to turn them off; the keyword CV reader works without them.
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_MODEL=Qwen/Qwen3-8B

# Contact string sent in the User-Agent of outgoing API requests
INGEST_CONTACT=team-email@example.com

# Protects POST /api/refresh (send it as the X-Refresh-Token header). Leave empty to disable refresh.
REFRESH_TOKEN=
