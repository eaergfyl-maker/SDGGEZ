{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "roles.json",
  "type": "object",
  "required": [
    "families",
    "roles"
  ],
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "short_name",
          "family",
          "requires",
          "skills",
          "sdg"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "name": {
            "type": "string"
          },
          "short_name": {
            "type": "string",
            "maxLength": 16
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "skill",
                "importance"
              ],
              "additionalProperties": false,
              "properties": {
                "skill": {
                  "type": "string"
                },
                "importance": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                }
              }
            }
          },
          "sdg": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 17
            },
            "minItems": 1
          },
          "family": {
            "type": "string"
          },
          "based_on": {
            "type": "object",
            "required": [
              "onet_code",
              "onet_title",
              "match"
            ],
            "additionalProperties": false,
            "properties": {
              "onet_code": {
                "type": "string",
                "pattern": "^\\d{2}-\\d{4}\\.\\d{2}$"
              },
              "onet_title": {
                "type": "string"
              },
              "match": {
                "enum": [
                  "direct",
                  "closest"
                ]
              }
            }
          }
        }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "name": {
            "type": "string"
          }
        }
      }
    }
  }
}
