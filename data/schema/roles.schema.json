{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "roles.json",
  "type": "object",
  "required": ["roles"],
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "short_name", "requires", "skills", "sdg"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string"},
          "short_name": {"type": "string", "maxLength": 16},
          "requires": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["skill", "importance"],
              "additionalProperties": false,
              "properties": {
                "skill": {"type": "string"},
                "importance": {"type": "integer", "minimum": 1, "maximum": 3}
              }
            }
          },
          "sdg": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 17}, "minItems": 1}
        }
      }
    }
  }
}
